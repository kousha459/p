<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PIN Vault</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@300;400;500;600&display=swap');
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #0d0d0f; --surface: #17171a; --border: #2a2a30;
    --accent: #7c6fff; --accent-dim: rgba(124,111,255,0.15);
    --danger: #ff6b6b; --success: #4ecb71; --warn: #f5a623;
    --text: #e8e8ec; --muted: #6b6b7a;
    --mono: 'Space Mono', monospace; --sans: 'Inter', sans-serif;
  }
  body { background: var(--bg); color: var(--text); font-family: var(--sans); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 40px 36px; width: 100%; max-width: 380px; }
  .eyebrow { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; margin-bottom: 8px; }
  h1 { font-size: 22px; font-weight: 600; margin-bottom: 4px; }
  .subtitle { font-size: 13px; color: var(--muted); margin-bottom: 32px; line-height: 1.5; }
  .pin-box { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 28px 20px; text-align: center; margin-bottom: 20px; }
  .pin-label { font-size: 11px; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; }
  .pin-digits { font-family: var(--mono); font-size: 52px; font-weight: 700; letter-spacing: 0.22em; line-height: 1; transition: filter 0.6s ease, color 0.4s ease; user-select: none; }
  .pin-digits.hidden { filter: blur(14px); color: var(--muted); }
  .pin-digits.visible { filter: blur(0); color: var(--accent); }
  .pin-digits.revealed-final { filter: blur(0); color: var(--success); }
  .pin-empty { font-family: var(--mono); font-size: 36px; letter-spacing: 0.25em; color: var(--border); line-height: 1; }
  .banner { border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; display: none; align-items: center; gap: 10px; font-size: 13px; font-weight: 500; line-height: 1.4; }
  .banner.active { display: flex; }
  .banner-success { background: rgba(78,203,113,0.1); border: 1px solid var(--success); color: var(--success); }
  .banner-accent { background: var(--accent-dim); border: 1px solid var(--accent); color: var(--accent); }
  .entry-bar-wrap { margin-bottom: 20px; display: none; }
  .entry-bar-wrap.active { display: block; }
  .entry-bar-label { font-size: 11px; color: var(--warn); margin-bottom: 6px; display: flex; justify-content: space-between; }
  .entry-bar-track { background: var(--border); border-radius: 99px; height: 5px; overflow: hidden; }
  .entry-bar-fill { height: 100%; background: var(--warn); border-radius: 99px; transition: width 0.5s linear; }
  .countdown-wrap { background: var(--accent-dim); border: 1px solid var(--accent); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px; display: none; align-items: center; justify-content: space-between; }
  .countdown-wrap.active { display: flex; }
  .countdown-label { font-size: 12px; color: var(--accent); font-weight: 500; }
  .countdown-time { font-family: var(--mono); font-size: 16px; color: var(--accent); font-weight: 700; }
  .section-label { font-size: 12px; color: var(--muted); font-weight: 500; letter-spacing: 0.06em; margin-bottom: 10px; }
  .time-row { display: flex; gap: 10px; margin-bottom: 24px; align-items: flex-end; }
  .time-group { flex: 1; display: flex; flex-direction: column; gap: 6px; }
  .time-group label { font-size: 11px; color: var(--muted); text-align: center; }
  .time-group input { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-family: var(--mono); font-size: 20px; font-weight: 700; padding: 12px 8px; text-align: center; width: 100%; outline: none; transition: border-color 0.2s; -moz-appearance: textfield; }
  .time-group input::-webkit-inner-spin-button, .time-group input::-webkit-outer-spin-button { -webkit-appearance: none; }
  .time-group input:focus { border-color: var(--accent); }
  .time-sep { font-family: var(--mono); font-size: 24px; color: var(--muted); padding-bottom: 10px; font-weight: 700; }
  .btn { width: 100%; padding: 14px; border-radius: 12px; border: none; font-family: var(--sans); font-size: 14px; font-weight: 600; cursor: pointer; transition: opacity 0.2s, transform 0.1s; letter-spacing: 0.02em; margin-bottom: 10px; }
  .btn:active { transform: scale(0.98); }
  .btn:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-success { background: var(--success); color: #0d0d0f; }
  .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); font-size: 13px; padding: 10px; margin-bottom: 0; }
  .btn-ghost:hover:not(:disabled) { color: var(--danger); border-color: var(--danger); }
  .divider { border: none; border-top: 1px solid var(--border); margin: 20px 0; }
  .status-note { font-size: 11px; color: var(--muted); text-align: center; margin-top: 4px; line-height: 1.5; }
</style>
</head>
<body>
<div class="card">
  <p class="eyebrow">Screen Time Tool</p>
  <h1>PIN Vault</h1>
  <p class="subtitle">Generate a PIN, enter it into Screen Time, then it hides itself until your chosen time.</p>

  <div class="pin-box">
    <p class="pin-label" id="pinLabel">Your PIN</p>
    <div id="pinEmpty" class="pin-empty">— — — —</div>
    <div id="pinDigits" class="pin-digits hidden" style="display:none"></div>
  </div>

  <div class="entry-bar-wrap" id="entryBarWrap">
    <div class="entry-bar-label">
      <span>⏳ Visible window — enter it in Screen Time now</span>
      <span id="entryTimerLabel">30s</span>
    </div>
    <div class="entry-bar-track"><div class="entry-bar-fill" id="entryBarFill" style="width:100%"></div></div>
  </div>

  <div class="countdown-wrap" id="countdownWrap">
    <span class="countdown-label">🔒 Reveals in</span>
    <span class="countdown-time" id="countdownTime">--:--:--</span>
  </div>

  <div class="banner banner-success" id="revealBanner">
    <span>✅</span> Time's up — tap Reveal to see your PIN
  </div>

  <div id="setupSection">
    <p class="section-label">Lock delay (after the 30s entry window)</p>
    <div class="time-row">
      <div class="time-group">
        <label>Hours</label>
        <input type="number" id="hrs" min="0" max="23" value="1">
      </div>
      <span class="time-sep">:</span>
      <div class="time-group">
        <label>Minutes</label>
        <input type="number" id="mins" min="0" max="59" value="0">
      </div>
      <span class="time-sep">:</span>
      <div class="time-group">
        <label>Seconds</label>
        <input type="number" id="secs" min="0" max="59" value="0">
      </div>
    </div>
    <button class="btn btn-primary" onclick="generate()">Generate PIN</button>
    <p class="status-note">You'll have 30 seconds to type the PIN into Screen Time before it hides.</p>
  </div>

  <div id="lockedSection" style="display:none">
    <button class="btn btn-success" id="revealBtn" onclick="revealPin()" disabled>Reveal PIN</button>
    <hr class="divider">
    <button class="btn btn-ghost" onclick="reset()">Start over (clears PIN)</button>
  </div>
</div>

<script>
  const ENTRY_WINDOW = 30;
  let pin = null, revealAt = null, entryEndsAt = null;
  let mainTicker = null, entryTicker = null;

  (function restore() {
    try {
      const s = JSON.parse(sessionStorage.getItem('pinVault') || 'null');
      if (!s || !s.pin) return;
      pin = s.pin; revealAt = s.revealAt; entryEndsAt = s.entryEndsAt;
      showPinDigits();
      if (Date.now() < entryEndsAt) { startEntryWindow(); } else { hidePinNow(); showLockedUI(); }
      mainTicker = setInterval(mainTick, 500);
    } catch(e) { sessionStorage.removeItem('pinVault'); }
  })();

  function generate() {
    const h = parseInt(document.getElementById('hrs').value)||0;
    const m = parseInt(document.getElementById('mins').value)||0;
    const s = parseInt(document.getElementById('secs').value)||0;
    const delayMs = (h*3600 + m*60 + s) * 1000;
    if (delayMs < 1000) { alert('Please set at least 1 second delay.'); return; }
    pin = String(Math.floor(Math.random()*10000)).padStart(4,'0');
    entryEndsAt = Date.now() + ENTRY_WINDOW * 1000;
    revealAt = entryEndsAt + delayMs;
    sessionStorage.setItem('pinVault', JSON.stringify({pin, revealAt, entryEndsAt}));
    showPinDigits(); showPinVisible(); startEntryWindow(); showLockedUI();
    document.getElementById('setupSection').style.display = 'none';
    mainTicker = setInterval(mainTick, 500);
  }

  function showPinDigits() {
    document.getElementById('pinEmpty').style.display = 'none';
    const pd = document.getElementById('pinDigits');
    pd.style.display = 'block'; pd.textContent = pin;
  }

  function showPinVisible() {
    document.getElementById('pinDigits').className = 'pin-digits visible';
    document.getElementById('pinLabel').textContent = '👁 Enter this in Screen Time now';
  }

  function hidePinNow() {
    document.getElementById('pinDigits').className = 'pin-digits hidden';
    document.getElementById('pinLabel').textContent = 'Your PIN';
    document.getElementById('entryBarWrap').classList.remove('active');
    clearInterval(entryTicker);
  }

  function showLockedUI() { document.getElementById('lockedSection').style.display = 'block'; }

  function startEntryWindow() {
    document.getElementById('entryBarWrap').classList.add('active');
    updateEntryBar();
    entryTicker = setInterval(updateEntryBar, 200);
  }

  function updateEntryBar() {
    const remaining = Math.max(0, entryEndsAt - Date.now());
    const pct = (remaining / (ENTRY_WINDOW * 1000)) * 100;
    document.getElementById('entryBarFill').style.width = pct + '%';
    document.getElementById('entryTimerLabel').textContent = Math.ceil(remaining/1000) + 's';
    if (remaining <= 0) { hidePinNow(); }
  }

  function mainTick() {
    const remaining = revealAt - Date.now();
    if (remaining <= 0) {
      clearInterval(mainTicker);
      document.getElementById('countdownWrap').classList.remove('active');
      document.getElementById('revealBanner').classList.add('active');
      document.getElementById('revealBtn').disabled = false;
    } else if (Date.now() >= entryEndsAt) {
      document.getElementById('countdownWrap').classList.add('active');
      document.getElementById('countdownTime').textContent = formatTime(remaining);
    }
  }

  function formatTime(ms) {
    const t = Math.ceil(ms/1000);
    return [Math.floor(t/3600), Math.floor((t%3600)/60), t%60].map(n=>String(n).padStart(2,'0')).join(':');
  }

  function revealPin() {
    document.getElementById('pinDigits').className = 'pin-digits revealed-final';
    document.getElementById('pinLabel').textContent = '🔓 PIN revealed';
    document.getElementById('revealBanner').classList.remove('active');
    document.getElementById('revealBtn').disabled = true;
    document.getElementById('revealBtn').textContent = '✓ PIN Visible Above';
  }

  function reset() {
    if (!confirm('Clear the current PIN and start over?')) return;
    clearInterval(mainTicker); clearInterval(entryTicker);
    pin = null; revealAt = null; entryEndsAt = null;
    sessionStorage.removeItem('pinVault');
    document.getElementById('pinEmpty').style.display = 'block';
    document.getElementById('pinDigits').style.display = 'none';
    document.getElementById('pinLabel').textContent = 'Your PIN';
    document.getElementById('entryBarWrap').classList.remove('active');
    document.getElementById('countdownWrap').classList.remove('active');
    document.getElementById('revealBanner').classList.remove('active');
    document.getElementById('setupSection').style.display = 'block';
    document.getElementById('lockedSection').style.display = 'none';
    document.getElementById('revealBtn').textContent = 'Reveal PIN';
  }
</script>
</body>
</html>
